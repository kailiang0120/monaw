{
  "name": "monaw-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build:renderer": "vite build",
    "build": "vite build",
    "test": "vitest run && npm run test:electron",
    "test:electron": "node --test electron/*.test.cjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "npm run test && npm run typecheck && npm run build:renderer",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results/vitest.xml && npm run test:electron",
    "verify:ci": "npm run test:ci && npm run typecheck && npm run build:renderer",
    "typecheck:app": "tsc --noEmit -p tsconfig.e2e.json",
    "test:app": "npm run build:renderer && npm run typecheck:app && playwright test",
    "preview": "vite preview",
    "package:win": "npm run build:renderer && electron-builder --win --x64",
    "package:win:dir": "npm run build:renderer && electron-builder --win --x64 --dir",
    "test:packaged": "npm run typecheck:app && playwright test -c playwright.packaged.config.ts"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.4"
  },
  "build": {
    "appId": "com.monaw.agent",
    "productName": "Monaw",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "assets/app-icon.png",
      "config/runtime.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/monaw-backend",
        "to": "backend"
      },
      {
        "from": "../browser-extension",
        "to": "browser-extension"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Monaw-Setup-${version}-x64.${ext}"
    }
  }
}
